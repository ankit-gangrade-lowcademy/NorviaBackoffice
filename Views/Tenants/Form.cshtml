@model TenantFormViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Edit Tenant":"Create Tenant";}
<div class="form-card"><h1>@ViewData["Title"]</h1><p>@(edit?"Update the organization and its availability.":"Add an organization to the shared Tenant table.")</p><form method="post"><input asp-for="Id" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" placeholder="e.g. Westbridge University"><span asp-validation-for="Name"></span></div><div class="check-field"><input asp-for="IsActive"><label asp-for="IsActive"></label></div><div class="form-actions"><a class="button ghost" asp-action="Index">Cancel</a><button class="button primary">@(edit?"Save Changes":"Create Tenant")</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
