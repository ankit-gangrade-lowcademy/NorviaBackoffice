@model IReadOnlyList<NorviaBackoffice.Models.Entities.Tenant>
@{ViewData["Title"]="Tenants";}
<div class="page-head"><div><div class="eyebrow">University of Norvia · SaaS Operations</div><h1>Tenant Management</h1><p>Create and maintain organizations subscribed to Norvia products.</p></div><a class="button primary" asp-action="Create">+ Create Tenant</a></div><div class="stats"><div class="stat"><b>@ViewBag.ActiveCount</b><span>Active tenants</span></div><div class="stat"><b>@ViewBag.AdminCount</b><span>Tenant administrators</span></div><div class="stat"><b>@ViewBag.BackofficeCount</b><span>Backoffice administrators</span></div></div><div class="data-card"><form class="toolbar" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search tenants..."><button class="button ghost">Search</button></form><div class="table-wrap"><table><thead><tr><th>Tenant</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b><br><small class="record-id">#@x.Id</small></td><td><span class="badge-status @(x.IsActive?"":"off")">@(x.IsActive?"Active":"Inactive")</span></td><td><a class="action-link" asp-action="Edit" asp-route-id="@x.Id">Edit</a></td></tr>}@if(Model.Count==0){<tr><td colspan="3">No tenants found.</td></tr>}</tbody></table></div></div>
