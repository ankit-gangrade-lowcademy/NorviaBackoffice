@model ProductFormViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Edit Product":"Add Product";}
<div class="form-card"><h1>@ViewData["Title"]</h1><p>Maintain a product in the Norvia product catalogue.</p><form method="post"><input asp-for="Id" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" placeholder="Product name"><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Description"></label><textarea asp-for="Description" placeholder="What does this product do?"></textarea><span asp-validation-for="Description"></span></div><div class="form-actions"><a class="button ghost" asp-action="Index">Cancel</a><button class="button primary">@(edit?"Save Changes":"Add Product")</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
