@model IReadOnlyList<NorviaBackoffice.Models.Entities.NorviaProduct>
@{ViewData["Title"]="Products";}
<div class="page-head"><div><div class="eyebrow">Platform Catalogue</div><h1>Product Management</h1><p>Manage the products available across the Norvia platform.</p></div><a class="button primary" asp-action="Create">+ Add Product</a></div><div class="data-card"><div class="table-wrap"><table><thead><tr><th>ID</th><th>Product name</th><th>Description</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td class="record-id">#@x.Id</td><td><b>@x.Name</b></td><td>@(x.Description??"—")</td><td><a class="action-link" asp-action="Edit" asp-route-id="@x.Id">Edit</a></td></tr>}@if(Model.Count==0){<tr><td colspan="4">No products found.</td></tr>}</tbody></table></div></div>
