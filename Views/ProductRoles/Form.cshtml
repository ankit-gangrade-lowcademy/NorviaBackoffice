@model ProductRoleFormViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Edit Product Role":"Add Product Role";}
<div class="form-card"><h1>@ViewData["Title"]</h1><p>Map a named role to a product-specific platform role ID.</p><form method="post"><input asp-for="Id" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Name"></label><input asp-for="Name"><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="ProductId"></label><select asp-for="ProductId" asp-items="Model.Products"><option value="">Select product</option></select><span asp-validation-for="ProductId"></span></div><div class="field"><label asp-for="ProductRoleId"></label><input asp-for="ProductRoleId"><span asp-validation-for="ProductRoleId"></span></div><div class="field"><label asp-for="Order"></label><input asp-for="Order"><span asp-validation-for="Order"></span></div><div class="form-actions"><a class="button ghost" asp-action="Index">Cancel</a><button class="button primary">@(edit?"Save Changes":"Add Role")</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
