@model IReadOnlyList<NorviaBackoffice.Models.Entities.ProductUserRole>
@{ViewData["Title"]="Product Roles";}
<div class="page-head"><div><div class="eyebrow">Product Access Control</div><h1>Product Roles</h1><p>Map each product to role identifiers used by its underlying platform.</p></div><a class="button primary" asp-action="Create">+ Add Role</a></div><div class="data-card"><div class="table-wrap"><table><thead><tr><th>Role name</th><th>Product</th><th>Product Role ID</th><th>Order</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Product.Name</td><td><code>@x.ProductRoleId</code></td><td>@x.Order</td><td><a class="action-link" asp-action="Edit" asp-route-id="@x.Id">Edit</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5">No product roles found.</td></tr>}</tbody></table></div></div>
