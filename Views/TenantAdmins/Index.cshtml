@model IReadOnlyList<NorviaBackoffice.Models.Entities.UserExtended>
@{ViewData["Title"]="Tenant Administrators";}
<div class="page-head"><div><div class="eyebrow">Intelli Campus Access</div><h1>Tenant Administrators</h1><p>Maintain customer administrators and provision them separately into Intelli Campus.</p></div><a class="button primary" asp-action="Create">+ Create Tenant Admin</a></div><div class="data-card"><form class="toolbar" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search administrators..."><button class="button ghost">Search</button></form><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Tenant</th><th>View</th><th>Provision Status</th><th>Provision</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><a class="action-link" asp-action="Edit" asp-route-id="@x.Id">@x.Name @x.Surname</a></td><td>@x.Email</td><td>@x.Tenant.Name</td><td><a class="button ghost" asp-action="Details" asp-route-id="@x.Id">View</a></td><td><span class="badge-status @(string.IsNullOrWhiteSpace(x.OutSystemsUserId)?"pending":"")">@(string.IsNullOrWhiteSpace(x.OutSystemsUserId)?"Not Provisioned":"Provisioned")</span></td><td><form asp-action="Provision" asp-route-id="@x.Id" method="post"><button class="button primary" disabled="@(!string.IsNullOrWhiteSpace(x.OutSystemsUserId))">@(string.IsNullOrWhiteSpace(x.OutSystemsUserId)?"Provision":"Provisioned")</button></form></td></tr>}@if(Model.Count==0){<tr><td colspan="6">No tenant administrators found.</td></tr>}</tbody></table></div></div>
