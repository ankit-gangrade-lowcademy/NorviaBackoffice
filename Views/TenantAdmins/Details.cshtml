@model NorviaBackoffice.Models.Entities.UserExtended
@{ViewData["Title"]="Tenant Administrator";}
<div class="detail-card"><h1>@Model.Name @Model.Surname</h1><p>Tenant administrator details</p><dl class="detail-list"><div><dt>Email</dt><dd>@Model.Email</dd></div><div><dt>Tenant</dt><dd>@Model.Tenant.Name</dd></div><div><dt>Phone</dt><dd>@(Model.PhoneNumber??"Not supplied")</dd></div><div><dt>Internal ID</dt><dd>@(Model.UserInternalId??"Not supplied")</dd></div><div><dt>Product Role ID</dt><dd>@(Model.UserRoleId?.ToString()??"Not assigned")</dd></div><div><dt>Status</dt><dd>@(Model.IsActive?"Active":"Inactive")</dd></div><div><dt>Provision Status</dt><dd>@(string.IsNullOrWhiteSpace(Model.OutSystemsUserId)?"Not Provisioned":"Provisioned")</dd></div><div><dt>OutSystems User ID</dt><dd>@(Model.OutSystemsUserId??"Not assigned")</dd></div></dl><div class="form-actions"><a class="button ghost" asp-action="Index">Back</a><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a></div></div>
