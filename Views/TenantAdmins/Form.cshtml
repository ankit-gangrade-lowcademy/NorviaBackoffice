@model TenantAdminFormViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Edit Tenant Admin":"Create Tenant Admin";}
<div class="form-card"><h1>@ViewData["Title"]</h1><p>Save the tenant user locally. Provisioning is performed separately from the list.</p><form method="post"><input asp-for="Id" type="hidden"><input asp-for="UpdatedOn" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="TenantId"></label><select asp-for="TenantId" asp-items="Model.Tenants"><option value="">Select tenant</option></select><span asp-validation-for="TenantId"></span></div><div class="row"><div class="col-md-6 field"><label asp-for="Name"></label><input asp-for="Name"><span asp-validation-for="Name"></span></div><div class="col-md-6 field"><label asp-for="Surname"></label><input asp-for="Surname"><span asp-validation-for="Surname"></span></div></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"><span asp-validation-for="Email"></span></div><div class="row"><div class="col-md-6 field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber"><span asp-validation-for="PhoneNumber"></span></div><div class="col-md-6 field"><label asp-for="UserInternalId"></label><input asp-for="UserInternalId"><span asp-validation-for="UserInternalId"></span></div></div><div class="field"><label asp-for="UserRoleId"></label><input asp-for="UserRoleId" type="number"><span asp-validation-for="UserRoleId"></span></div><div class="field"><label asp-for="Address"></label><textarea asp-for="Address"></textarea><span asp-validation-for="Address"></span></div><div class="check-field"><input asp-for="IsActive"><label asp-for="IsActive"></label></div><div class="notice success">Saving writes UserExtended only. Use the separate Provision action when this record is ready for Intelli Campus.</div><div class="form-actions"><a class="button ghost" asp-action="Index">Cancel</a><button class="button primary">@(edit?"Save Changes":"Create Admin")</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
