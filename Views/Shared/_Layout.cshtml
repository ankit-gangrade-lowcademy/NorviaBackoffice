@using System.Security.Claims
@{ var role=User.FindFirstValue(ClaimTypes.Role); var isSuper=role=="Super Admin"; var canManage=role is "Super Admin" or "Admin" or "Backoffice Admin"; var initials=string.Join("",(User.Identity?.Name??"NA").Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))); }
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] | Norvia Backoffice</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head><body><header class="top"><a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="mark">NB</span><span>Norvia Backoffice</span><span class="phase">.NET 10</span></a><button class="mobile-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#appNav">☰</button><div class="collapse app-nav" id="appNav"><nav>@if(canManage){<a class="nav-item-link" asp-controller="Tenants" asp-action="Index">Tenants</a><a class="nav-item-link" asp-controller="TenantAdmins" asp-action="Index">Tenant Admins</a>}@if(isSuper){<a class="nav-item-link" asp-controller="BackofficeUsers" asp-action="Index">Backoffice Admins</a><a class="nav-item-link" asp-controller="Products" asp-action="Index">Products</a><a class="nav-item-link" asp-controller="ProductRoles" asp-action="Index">Roles</a>}</nav><div class="top-right"><div class="dropdown"><button class="user-menu" data-bs-toggle="dropdown"><span class="avatar">@initials</span><span><b>@User.Identity?.Name</b><small>@role</small></span></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a></li><li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li><li><hr class="dropdown-divider"></li><li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item text-danger">Logout</button></form></li></ul></div></div></div></header><main class="shell">@if(TempData["StatusMessage"] is string status){<div class="notice success">@status</div>}@if(TempData["ErrorMessage"] is string error){<div class="notice error">@error</div>}@RenderBody()</main><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",false)</body></html>
