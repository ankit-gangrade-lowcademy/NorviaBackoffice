@model BackofficeUserFormViewModel
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Edit Backoffice Admin":"Create Backoffice Admin";}
<div class="form-card"><h1>@ViewData["Title"]</h1><p>Manage a Norvia operator account and its server-enforced role.</p><form method="post"><input asp-for="Id" type="hidden"><div asp-validation-summary="ModelOnly"></div><div class="field"><label asp-for="Name"></label><input asp-for="Name"><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email"><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="RoleId"></label><select asp-for="RoleId" asp-items="Model.Roles"><option value="">Select role</option></select><span asp-validation-for="RoleId"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" placeholder="@(edit?"Leave blank to keep current password":"At least 12 characters")"><span asp-validation-for="Password"></span></div><div class="check-field"><input asp-for="IsActive"><label asp-for="IsActive"></label></div><div class="check-field"><input asp-for="MustChangePassword"><label asp-for="MustChangePassword"></label></div><div class="form-actions"><a class="button ghost" asp-action="Index">Cancel</a><button class="button primary">@(edit?"Save Changes":"Create Admin")</button></div></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
