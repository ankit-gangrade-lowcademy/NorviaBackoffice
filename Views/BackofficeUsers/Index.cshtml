@model IReadOnlyList<NorviaBackoffice.Models.Entities.NorviaUser>
@{ViewData["Title"]="Backoffice Administrators";}
<div class="page-head"><div><div class="eyebrow">Norvia Internal Access</div><h1>Backoffice Administrators</h1><p>Manage internal staff who operate this backoffice.</p></div><a class="button primary" asp-action="Create">+ Create Backoffice Admin</a></div><div class="data-card"><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.Name</b></td><td>@x.Email</td><td>@x.Role.Name</td><td><span class="badge-status @(x.IsActive?"":"off")">@(x.IsActive?"Active":"Inactive")</span></td><td><a class="action-link" asp-action="Edit" asp-route-id="@x.Id">Edit</a></td></tr>}@if(Model.Count==0){<tr><td colspan="5">No backoffice users found.</td></tr>}</tbody></table></div></div>
