@model ProfileViewModel
@{ ViewData["Title"]="My Profile"; }
<div class="row justify-content-center"><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h1 class="h3 mb-4">My Profile</h1><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" disabled></div><div class="col-md-6"><label asp-for="Role" class="form-label"></label><input asp-for="Role" class="form-control" disabled></div><div class="col-md-6"><label class="form-label">Account Status</label><input class="form-control" value="@(Model.IsActive ? "Active" : "Inactive")" disabled></div><div class="col-12"><span class="text-muted">Last login: @(Model.LastLoginOn?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? "Not recorded")</span></div></div><button class="btn btn-primary mt-4" type="submit">Save changes</button></form></div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
